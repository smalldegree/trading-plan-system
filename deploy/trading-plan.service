[Unit]
Description=Trading Plan System
After=network.target mysql.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/www/html/trading-plan-system/server
ExecStart=/usr/bin/node /var/www/html/trading-plan-system/server/src/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
