# 服务端口
PORT=3000

# JWT 密钥（生产环境请务必修改为随机字符串）
JWT_SECRET=please-change-me-to-a-random-secret
JWT_EXPIRES_IN=7d

# 数据库客户端：better-sqlite3 | sqlite3 | mysql | mysql2 | pg
DB_CLIENT=better-sqlite3

# SQLite 文件路径（仅 sqlite3 使用）
DB_FILENAME=./data/trading.sqlite

# MySQL / PostgreSQL 连接配置（切换 DB_CLIENT 后使用）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trading_plan
